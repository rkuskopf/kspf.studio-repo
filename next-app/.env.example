# Server-only Storyblok delivery configuration. Never use NEXT_PUBLIC_ tokens.
STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_PREVIEW_TOKEN=
STORYBLOK_REGION=eu

# Deployed signed preview is disabled unless exactly true. Not required for next dev.
STORYBLOK_PREVIEW_ENABLED=false
# Required for deployed draft preview; use the space ID from Storyblok Settings.
STORYBLOK_SPACE_ID=
# Optional origin only, e.g. https://your-preview.vercel.app. Defaults to VERCEL_URL on Vercel.
SITE_URL=
